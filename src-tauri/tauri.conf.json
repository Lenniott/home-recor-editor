{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "home-recor-editor",
  "version": "0.1.0",
  "identifier": "com.benjamin.home-recor-editor",
  "build": {
    "beforeDevCommand": "npm run build:whisper && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:whisper && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Home Recor Editor",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/whisper-cli"
    ],
    "resources": [
      "binaries/whisper-LICENSE"
    ]
  }
}
